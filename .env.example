# Copy to .env and fill in. Real environment variables take precedence over .env.

# --- Model (required) ---------------------------------------------------------
# Any provider supported by LangChain's init_chat_model. Install its package too,
# e.g. pip install -e ".[ollama]" or ".[openai]".
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3.5:9b
# Optional: custom endpoint (company-hosted / OpenAI-compatible server, remote Ollama)
MODEL_BASE_URL=
MODEL_TEMPERATURE=0
# Ollama only: the model's context window in tokens. Ollama's own default (4096) is too
# small: it silently drops the start of the conversation. Cloud providers ignore this.
MODEL_CONTEXT_TOKENS=16384
# How the final report is requested: function_calling (most portable), json_schema, json_mode
MODEL_STRUCTURED_OUTPUT_METHOD=function_calling
# Provider credentials use the provider's own variable names, e.g.:
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=

# --- Agent limits ---------------------------------------------------------------
AGENT_OUTPUT_DIR=outputs
AGENT_RUN_TIMEOUT_S=600
AGENT_TOOL_TIMEOUT_S=30
